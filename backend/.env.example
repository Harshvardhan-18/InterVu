# Copy to backend/.env and fill in (`make setup-backend` or `make backend-env`
# does the copy and generates AUTH_SECRET). Never commit real values.

# ── App ────────────────────────────────────────────────────────────────────────
# Fails closed: only development | dev | test | local count as development.
# Unset ENV (or any other value, e.g. production) is treated as production:
# AUTH_SECRET is mandatory, AUTH_DISABLED is ignored and the localhost CORS
# origins are not added. Keep ENV=development for local work.
ENV=development
BACKEND_PORT=8000
# Comma-separated list of allowed browser origins for CORS.
FRONTEND_URL=http://localhost:3000
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ── Auth ───────────────────────────────────────────────────────────────────────
# Signing key for bearer access tokens. REQUIRED: `make backend-env` fills it
# when blank, or generate one with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# If it is unset in a development ENV a random per-process key is used, and
# every uvicorn --reload or restart then signs everybody out.
AUTH_SECRET=
# Access token lifetime in hours (default 168 = one week).
AUTH_TOKEN_TTL_HOURS=168
# Local debugging only: "true" skips bearer token checks. Ignored unless ENV
# is a development value.
AUTH_DISABLED=false

# ── Rate limits (in-memory, per process) ──────────────────────────────────────
# Sign-in attempts per client IP per minute, interview starts per user per
# hour. 0 disables a limit. RATE_LIMIT_ENABLED=true|false forces limiting on
# or off (default: on, except ENV=test).
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_START_PER_HOUR=20
# Views of public shared-report links per client IP per minute.
RATE_LIMIT_PUBLIC_PER_MIN=60
# Resume uploads per user per hour.
RATE_LIMIT_UPLOAD_PER_HOUR=10

# ── Migrations, usage and monitoring ───────────────────────────────────────────
# true (default): run `alembic upgrade head` at startup. false: use create_all
# and run `make migrate` yourself as a deploy step.
MIGRATE_ON_START=true
# Maximum LLM tokens per user per UTC day (0 = unlimited).
DAILY_TOKEN_LIMIT=0
# USD per million tokens; when set, usage shows estimated dollars. Leave blank
# for tokens only (prices differ per model and change, so none are built in).
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
# Optional Sentry error monitoring. Answers, resumes, request bodies, cookies,
# tokens and local variables are stripped before anything is sent.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=

# ── Research cache and sharing ─────────────────────────────────────────────────
# Days before cached company research is refreshed on the next interview start
# (0 = never expire). If a refresh fails the older research is still used.
RESEARCH_TTL_DAYS=30
# Public report links: default lifetime and the maximum an owner may choose.
SHARE_DEFAULT_DAYS=7
SHARE_MAX_DAYS=90

# ── Database ───────────────────────────────────────────────────────────────────
# SQLAlchemy (asyncpg) URL used by the API.
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/intervu
# psycopg URL used by the LangGraph Postgres checkpointer (same database).
DATABASE_URL_PSYCOPG=postgresql://postgres:your_password_here@localhost:5432/intervu
# require | verify-ca | verify-full | disable. "require" encrypts without
# checking the certificate; verify-ca checks the chain, verify-full also the
# host name. Unset: "require" for every host except localhost, 127.0.0.1, ::1
# and the docker-compose "postgres" service. Unknown values fail at startup.
DB_SSL=
# Optional CA bundle for verify-ca / verify-full (default: system trust store).
DB_SSL_ROOT_CERT=

# ── Groq (LLMs) ────────────────────────────────────────────────────────────────
# The extractor rotates across GROQ_API_KEY_1, GROQ_API_KEY_2, ...; the other
# agents use GROQ_API_KEY_2. When numbered keys are absent GROQ_API_KEY is used.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_1=
GROQ_API_KEY_2=
# Per-attempt LLM timeout (seconds) and attempts per call.
LLM_TIMEOUT_SECONDS=40
LLM_MAX_ATTEMPTS=2

# ── Google AI (embeddings) ─────────────────────────────────────────────────────
# Key rotation pool (add GOOGLE_API_KEY_3, ... as needed).
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
# Fallback single key, used when no numbered keys are set.
GOOGLE_API_KEY=your_single_google_api_key_here

# ── Search / scraping ──────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
ANAKIN_API_KEY=your_anakin_api_key_here

# ── ChromaDB ───────────────────────────────────────────────────────────────────
CHROMA_PATH=./chroma_db
CHROMA_COLLECTION=intervu_kb_v2
