{
  "expo": {
    "name": "InterVu",
    "slug": "intervu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "intervu",
    "backgroundColor": "#070d10",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.harshvardhan18.intervu",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.harshvardhan18.intervu",
      "adaptiveIcon": {
        "backgroundColor": "#070d10",
        "foregroundImage": "./assets/adaptive-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "da717cf5-3b40-4a26-9207-91446f754c07"
      },
      "router": {}
    },
    "install": {
      "exclude": [
        "react-native-svg"
      ]
    },
    "owner": "harshvardhxns-team"
  }
}
