# Copy to .env (next to docker-compose.yaml). Read only by docker compose.
#
# Postgres superuser password for the local container. Use only URL-safe
# characters (letters, digits, - _ . ~) because the compose backend service
# embeds it in DATABASE_URL. Use the same password in backend/.env
# DATABASE_URL and DATABASE_URL_PSYCOPG when running the backend on the host.
POSTGRES_PASSWORD=change_me_to_a_local_password

# Optional, used by `docker compose --profile app up`:
# Backend environment (default development). Unset ENV inside the backend is
# treated as production, so compose always passes this value through.
# ENV=development
# Browser origin allowed by the backend CORS policy.
# FRONTEND_URL=http://localhost:3000
# Backend URL baked into the frontend bundle at build time.
# NEXT_PUBLIC_API_URL=http://localhost:8000
