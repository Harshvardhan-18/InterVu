# Copy this file to .env and fill in values before running the service.
# NEVER commit .env -- it is gitignored.

# -- Django -------------------------------------------------------------------
# DEBUG defaults to False. Local development: set DJANGO_DEBUG=True.
DJANGO_DEBUG=True
# Required whenever DJANGO_DEBUG is False (startup fails without it). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated browser origins allowed to call the admin API.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# HTTPS-only session/CSRF cookies. Defaults to True when DJANGO_DEBUG is False.
# DJANGO_SECURE_COOKIES=True

# -- Database (InterVu read-only) ----------------------------------------------
# Leave blank during local development -- SQLite is used automatically.
# Fill in ONLY after a read-only Postgres role has been confirmed by the team.
#
# INTERVU_DB_ENGINE=django.db.backends.postgresql
# INTERVU_DB_NAME=intervu
# INTERVU_DB_USER=intervu_readonly
# INTERVU_DB_PASSWORD=
# INTERVU_DB_HOST=localhost
# INTERVU_DB_PORT=5432

# -- Admin superuser (for local dev only) -------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=
