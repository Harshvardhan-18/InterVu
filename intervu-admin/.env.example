# Copy this file to .env and fill in values before running the service.
# NEVER commit .env -- it is gitignored.

# -- Django -------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# -- Database (InterVu read-only) ----------------------------------------------
# Leave blank during local development -- SQLite is used automatically.
# Fill in ONLY after a read-only Postgres role has been confirmed by the team.
#
# INTERVU_DB_ENGINE=django.db.backends.postgresql
# INTERVU_DB_NAME=intervu
# INTERVU_DB_USER=intervu_readonly
# INTERVU_DB_PASSWORD=
# INTERVU_DB_HOST=localhost
# INTERVU_DB_PORT=5432

# -- Admin superuser (for local dev only) -------------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=changeme
